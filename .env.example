# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# Railway / cloud deploys: ignore this file — set the same keys below as
# Service Variables in the Railway dashboard (the process reads the real
# environment; .env is only for local runs).

# Telegram bot token from @BotFather
BOT_TOKEN=

# Numeric owner/user ID (comma-separated allowed if the code supports it)
OWNER_ID=

# Bot username without @
BOT_USERNAME=

# MTProto / Telethon API credentials (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Tagging module MTProto phone/session label (module-specific)
TAG_MTPROTO=

# MongoDB connection (Atlas SRV or local). Database name defaults to pi_bot
# when the URI has no /dbname.
MONGO_URI=
